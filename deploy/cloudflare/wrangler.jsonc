// Probabilistic Monkey (152.6M) and Probabilistic Gorilla (516.9M) on Cloudflare
// Workers + Containers. The page lets visitors switch between the models.
// Deploy with:  npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "probabilistic-monkey",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "MonkeyContainer",
      "image": "./Dockerfile",
      // build from the repository root so the image can include app/, model/ and model_gorilla/
      "image_build_context": "../..",
      // 1 vCPU and 4 GiB: Monkey needs ~0.8 GB of RAM and Gorilla ~2.3 GB, so both fit at once
      "instance_type": { "vcpu": 1, "memory_mib": 4096, "disk_mb": 4000 },
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "MonkeyContainer", "name": "MONKEY" }]
  },
  "exports": {
    "MonkeyContainer": { "type": "durable-object", "storage": "sqlite" }
  }
}
