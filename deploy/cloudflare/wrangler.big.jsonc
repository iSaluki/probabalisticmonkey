// Probabilistic Monkey Big (516.9M) on Cloudflare Workers + Containers.
// Needs the trained model in model_big/. Deploy with:  npx wrangler deploy -c wrangler.big.jsonc
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "probabilistic-monkey-big",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "MonkeyContainer",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      "image_vars": { "MODEL_DIR": "model_big" },
      // custom size: 1 vCPU and 4 GiB; the Big model needs ~2.3 GB of RAM
      "instance_type": { "vcpu": 1, "memory_mib": 4096, "disk_mb": 4000 },
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "MonkeyContainer", "name": "MONKEY" }]
  },
  "exports": {
    "MonkeyContainer": { "type": "durable-object", "storage": "sqlite" }
  }
}
